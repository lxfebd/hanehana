# dependencies
node_modules/

# build output
app/out/
app/release/
app/dist/
# 单测转译产物（node --test 前 esbuild 落盘的中转 JS）
app/.test-build/

# rust engine
engine-rs/target/

# logs & temp
*.log
*.tmp

# os
.DS_Store
Thumbs.db

# 验收/测试产生的本地数据与截图（真实数据目录在用户主目录，不在工作树）
# 注意：app/build/ 不忽略——安装包图标 icon.ico 要入库
app/.e2e-data/
app/.*-data/
app/.*-portable/
app/.shots/
app/.*-game/
app/.*-game2/
app/.batch*-mock.json
app/.batch*-export/
# 命令输出重定向的残留（lint/probe 等的 stdout 落地文件）
app/eslint_out.txt
app/*_out.txt
# 批处理验收的临时输出（脚本跑完留下，非源码）
app/.batch*-err.txt
app/.batch*-out.txt
app/.b*/

# 图标管线的中间产物（只有 icon_src.png 输入 + icon.ico/tray.png/icon-256.png 输出入库）
app/build/icon_src_cropped.png
app/build/user_icon_icon.png

# 一次性探测/迁移脚本与它们的截图产物（用完即弃，不进仓库）
app/scripts/*_probe*.mjs
app/scripts/wide_shots/
app/hh_sites2.png
