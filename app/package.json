{
  "name": "hanehana",
  "version": "0.1.0",
  "description": "羽花 HaneHana — galgame 管理器：封面墙游戏库 + 多源元数据刮削 + Rust 下载引擎",
  "main": "./out/main/index.js",
  "author": "HaneHana",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "smoke": "node scripts/smoke_packaged.mjs",
    "icon": "python scripts/gen_icon_from_image.py && python scripts/sync_tray_icon.py",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/build_tests.mjs && node --test \".test-build/tests/*.test.js\"",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "regression": "node scripts/reg_all.mjs",
    "regression:static": "node scripts/reg_static.mjs",
    "regression:layout": "node scripts/reg_layout.mjs",
    "regression:app": "node scripts/reg_app.mjs",
    "regression:download": "node scripts/e2e_download.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.13",
    "electron": "44.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-vue-next": "^0.577.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  }
}
